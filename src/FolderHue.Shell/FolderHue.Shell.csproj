<Project Sdk="Microsoft.NET.Sdk">

  <!--
    In-process COM DLL, loaded inside explorer.exe.

    NativeAOT is not an optimisation here, it is a requirement (CLAUDE.md 2.1): a managed shell
    extension would load the CLR into Explorer, with the runtime version conflicts and crashes
    Microsoft formally advises against. The COM server is exposed through ComWrappers
    (StrategyBasedComWrappers plus the .NET 8 COM source generators), never through
    [ComVisible] or RegAsm, neither of which is supported under AOT.

    The DLL used to embed an MSIX identity manifest. It no longer does: the extension is
    registered under HKCU\Software\Classes as a classic in-process server, so there is no
    package identity to declare. With that manifest gone, the linker no longer conflicts with
    the Win32 resources ILCompiler emits, and the DLL gets its version block back.
  -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>FolderHue.Shell</AssemblyName>
    <RootNamespace>FolderHue.Shell</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableComHosting>false</EnableComHosting>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <!--
      Satellite assemblies do not survive NativeAOT compilation, so the menu always shows the
      neutral resources embedded in the image, which are the English ones. The settings
      application is not AOT-compiled and stays fully localised.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- A shell extension must start instantly and must never bring Explorer down. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <StackTraceSupport>false</StackTraceSupport>
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FolderHue.Core\FolderHue.Core.csproj" />
  </ItemGroup>

</Project>
