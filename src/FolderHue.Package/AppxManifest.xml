<?xml version="1.0" encoding="utf-8"?>

<!--
  Manifeste MSIX de FolderHue.

  Trois valeurs doivent correspondre AU CARACTERE PRES a
  src/FolderHue.Shell/FolderHue.Shell.manifest :
      Identity/@Name      <-> packageName
      Identity/@Publisher <-> publisher
      Application/@Id     <-> applicationId
  Et le CLSID doit correspondre a Com/Guids.cs. En cas d'ecart, l'entree n'apparait tout
  simplement pas dans le menu, sans le moindre message (CLAUDE.md Â§10).
  scripts/build.ps1 verifie ces quatre correspondances a chaque build.

  Le meme manifeste sert au paquet sparse de developpement et au MSIX complet destine au
  Microsoft Store ; build.ps1 retire AllowExternalContent pour ce dernier.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  IgnorableNamespaces="uap uap10 rescap com desktop4 desktop5">

  <Identity
    Name="FolderHueDev.FolderHue"
    Publisher="CN=FolderHueDev"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>FolderHue</DisplayName>
    <PublisherDisplayName>FolderHue</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Colorise les dossiers de l'Explorateur de fichiers depuis le menu contextuel.</Description>

    <!--
      Necessaire au paquet sparse (-ExternalLocation), utilise uniquement en developpement.
      build.ps1 retire cet element du manifeste du MSIX complet.
    -->
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <!--
      Windows 10 1809 et ulterieur. desktop4:FileExplorerContextMenus est supporte depuis
      Windows 10 1803 : le meme CLSID et la meme DLL servent le menu direct de Windows 11 et
      le menu classique de Windows 10 (CLAUDE.md Â§2).
    -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="fr-FR" />
    <Resource Language="en-US" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />

    <!--
      Exigee par la forme uap10:TrustLevel / uap10:RuntimeBehavior de l'element Application, qui
      declare une application Win32 classique packagee. Sans elle, makeappx refuse le paquet.
      C'est le couple de capacites que declarent les extensions de menu contextuel de PowerToys.
    -->
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="App" Executable="FolderHue.App.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">

      <uap:VisualElements
        AppListEntry="none"
        DisplayName="FolderHue"
        Description="Colorise les dossiers de l'Explorateur de fichiers."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>

        <!--
          Entree du menu contextuel. C'est bien desktop4/desktop5 et non uap3 :
          avec uap3 le manifeste ne valide pas.
          L'ordre des extensions et la presence de ItemType="*" reproduisent a l'identique les
          extensions de menu de PowerToys, seules references connues a fonctionner sur cette
          machine. ItemType="*" ne rend pas l'entree visible sur les fichiers : GetState renvoie
          ECS_HIDDEN des que la selection contient autre chose qu'un dossier.
        -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="FolderHue" Clsid="C228C2F8-706B-4A2E-9C48-74F3062BE146" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="FolderHue" Clsid="C228C2F8-706B-4A2E-9C48-74F3062BE146" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>


        <!--
          Serveur COM du menu, heberge dans un surrogate dllhost.exe.

          La contrainte venait a l'origine de windows.fileExplorerClassicContextMenuHandler, qui
          EXIGE un SurrogateServer et faisait refuser tout com4:InProcessServer :

            error 80080204 : Attribute "Clsid" ... must define an Element "Class"
            on element "SurrogateServer" on extension "windows.comServer"

          Cette extension a ete retiree (CLAUDE.md §4.6). Un hebergement in-proc redevient donc
          peut-etre possible, ce qui supprimerait le demarrage a froid du surrogate au premier
          clic droit (§4.7) : a verifier avant d'y toucher.
        -->
        <com:Extension Category="windows.comServer" uap10:RuntimeBehavior="packagedClassicApp">
          <com:ComServer>
            <com:SurrogateServer DisplayName="FolderHue Shell Extension">
              <com:Class
                Id="C228C2F8-706B-4A2E-9C48-74F3062BE146"
                Path="FolderHue.Shell.dll"
                ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

      </Extensions>
    </Application>
  </Applications>

</Package>







